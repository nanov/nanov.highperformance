<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Nanov.HighPerformance</RootNamespace>
    <AssemblyName>Nanov.HighPerformance</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet packaging -->
  <PropertyGroup>
    <PackageId>Nanov.HighPerformance</PackageId>
    <Description>High-performance, low-allocation concurrency building blocks for .NET: the SPSC worker family (bounded-mailbox actors / pipeline stages) — zero per-message allocation, blocking backpressure, sync and async, copy and zero-copy.</Description>
    <PackageTags>high-performance;low-allocation;concurrency;spsc;ring-buffer;worker;actor;channel;lock-free;zero-alloc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nanov.HighPerformance.Tests" />
  </ItemGroup>

</Project>
