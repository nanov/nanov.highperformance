<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Nanov.HighPerformance</RootNamespace>
    <AssemblyName>Nanov.HighPerformance</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet packaging -->
  <PropertyGroup>
    <PackageId>Nanov.HighPerformance</PackageId>
    <Description>High-performance, low-allocation building blocks for .NET: pooled writers, ref-struct collections, lock-free primitives, and span/binary helpers.</Description>
    <PackageTags>high-performance;low-allocation;span;buffers;pooling;lock-free;ref-struct;simd;zero-alloc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nanov.HighPerformance.Tests" />
  </ItemGroup>

</Project>
