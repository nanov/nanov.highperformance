<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <RootNamespace>Nanov.HighPerformance.Threading.Workers.PerfTests</RootNamespace>
    <AssemblyName>Nanov.HighPerformance.Threading.Workers.PerfTests</AssemblyName>

    <!-- Perf-harness levers, mirrored from Disruptor-net PR #51 (109 -> 173 Mops):
         tiered compilation keeps long-lived run loops in unoptimized tier-0 code, so we force
         full optimization from the first JIT. pdbonly symbols keep stacks readable without a debug build. -->
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HdrHistogram" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nanov.HighPerformance.Threading.Workers/Nanov.HighPerformance.Threading.Workers.csproj" />
  </ItemGroup>

</Project>
